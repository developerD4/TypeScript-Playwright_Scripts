{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "types": [
      "node"
    ],
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // "verbatimModuleSyntax":false
  },
  "include": [
    "framework/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
// step 1 - npx tsc --init
// step 2 - Enable "types": ["node"], under target in tsconfig.json
// step 3 - comment "verbatimModuleSyntax":false
// step 4 - npm i --save-dev @types/node