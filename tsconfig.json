{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "types": [
      "node"
    ],
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "framework/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}